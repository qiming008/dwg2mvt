# 工作目录（上传与转换产物）
APP_WORK_DIR=./data
# Python 输出采用 UTF-8，避免中文状态/日志乱码
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
LANG=C.UTF-8
LC_ALL=C.UTF-8
# LibreDWG：容器内直接使用 `dwg2dxf`，Windows 本地可填完整路径如 D:/Tools/libredwg/dwg2dxf.exe
APP_DWG2DXF_CMD=dwg2dxf
# 原图预览：DWG 优先使用 `dwg2SVG`，DXF 使用已转换 GPKG 生成轻量 SVG 预览
APP_DWG2SVG_CMD=dwg2SVG
APP_ORIGINAL_PREVIEW_TIMEOUT_SECONDS=300
# 可选：原图预览临时目录，避免本地 --reload 监听 backend/data 时被大文件写入触发重载
# APP_ORIGINAL_PREVIEW_TEMP_DIR=/tmp/libredwg_original_preview
# GDAL：容器内直接使用 `ogr2ogr`，Windows 本地可填完整路径如 C:/Program Files/OSGeo4W64/bin/ogr2ogr.exe
APP_OGR2OGR_CMD=ogr2ogr
# 输出坐标系（默认 WGS84 经纬度）
APP_TARGET_SRS=EPSG:4326
# 高斯 - 克吕格投影配置（用于 DWG 坐标转经纬度）
# 投影带号（1-60），根据经度确定：带号 = int(经度/6) + 31 (6 度带) 或 int(经度/3) + 1 (3 度带)
# 如果不设置，默认使用 39 带（适用于中国东部地区，如山东、江苏）
APP_GAUSS_KRUGER_ZONE=39
# 是否启用高斯 - 克吕格到 WGS84 的转换（默认启用）
APP_ENABLE_GAUSS_KRUGER_TRANSFORM=true
# GeoServer（可选，不配置则仅做 DWG→GPKG 转换）
APP_GEOSERVER_URL=http://172.24.4.66/geoserver
APP_GEOSERVER_USER=admin
APP_GEOSERVER_PASSWORD=geoserver
APP_GEOSERVER_WORKSPACE=dwg
# 前端访问 GeoServer 的地址（跨域时填公网或代理地址）
APP_GEOSERVER_PUBLIC_URL=/csrap_geoserver
# 可选：覆盖派生出的 WMTS 签名密钥
# APP_WMTS_SIGN_SECRET=change-me
# 可选：WMTS 签名有效期（秒）
# APP_WMTS_TOKEN_TTL_SECONDS=300
# 字典服务基础地址。Docker 里前端会通过后端代理这个接口；本地开发可保持默认值。
# APP_DICT_SERVICE_BASE_URL=http://172.24.4.66
